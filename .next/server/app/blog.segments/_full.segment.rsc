22:["$","section",null,{"className":"relative flex w-full flex-col items-center px-[30px] md:px-10 lg:px-[50px]","children":["$","$L1c",null,{"y":50,"className":"w-full max-w-[800px] md:max-w-[750px] lg:max-w-[1200px]","children":["$","$Lf",null,{"href":"/blog/articles/why-coffee-tastes-better-here.","className":"group flex w-full flex-col overflow-hidden rounded-[38.48px] bg-white p-3 lg:flex-row lg:items-center lg:gap-12 lg:rounded-[42px] lg:p-4","children":[["$","div",null,{"className":"relative aspect-[16/10] w-full shrink-0 overflow-hidden rounded-[32px] lg:w-[58%]","children":["$","$Le",null,{"src":"/brand/doodles/barista.png","alt":"Nookaa barista otter crafting a beverage.","fill":true,"priority":true,"sizes":"(min-width: 1200px) 680px, 100vw","className":"object-contain bg-cream p-8 transition-transform duration-500 ease-out group-hover:scale-[1.04]","style":"$undefined"}]}],["$","div",null,{"className":"flex flex-col items-center gap-5 px-3 pt-6 pb-6 text-center lg:items-start lg:px-0 lg:py-0 lg:pr-10 lg:text-left","children":[["$","span",null,{"className":"rounded-[100px] bg-orange px-4 py-1.5 font-chiron text-[14px]/[16.8px] font-bold text-brown","children":["Featured · ","Brewing"]}],["$","h2",null,{"className":"font-autour text-[26px]/[34px] text-brown lg:text-[42px]/[54px]","children":"Why Coffee Tastes Better Here."}],["$","p",null,{"className":"font-chiron text-[16px]/[22.4px] text-brown lg:text-[20px]/[28px]","children":"Fresh beans, careful preparation and a great sip to go. Here’s what really goes into every nookaa cup."}],["$","p",null,{"className":"font-chiron text-[14px]/[16.8px] font-medium text-ash","children":["Jan 20, 2026"," · ","4 min read"]}],["$","span",null,{"className":"inset-border relative inline-flex w-min items-center justify-center rounded-[100px] bg-orange px-8 py-3 font-chiron text-[18px]/[21.6px] font-bold whitespace-pre text-brown shadow-press transition-[transform,box-shadow] duration-200 ease-out [--border-color:var(--colo