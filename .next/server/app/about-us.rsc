27:["$","section",null,{"className":"relative flex w-full flex-col items-center bg-cream px-5 pb-[50px] md:px-10 md:pb-[70px] lg:px-[50px] lg:pb-[100px]","children":["$","$L1c",null,{"y":50,"className":"w-full max-w-[800px] md:max-w-[1000px]","children":["$","div",null,{"className":"flex w-full items-center justify-center rounded-[45px] bg-orange p-[14.85px] md:rounded-[88px] md:p-[25px]","children":["$","div",null,{"className":"inset-border inset-border-dashed relative flex w-px flex-1 flex-col items-center gap-8 rounded-[31px] p-6 [--border-color:var(--color-brown)] [--border-width:1.98px] md:flex-row md:gap-12 md:rounded-[61px] md:p-10 md:[--border-width:3px] lg:p-[50px]","children":[["$","div",null,{"className":"relative aspect-square w-[220px] shrink-0 overflow-hidden rounded-full bg-cream md:w-[260px] lg:w-[320px]","children":["$","div",null,{"className":"absolute inset-[10%_12%_4%]","children":["$","$Le",null,{"src":"/brand/doodles/barista.png","width":1254,"height":1254,"alt":"Nookaa’s original otter mascot with sunglasses, a blue scarf, brown apron and an iced lemon drink.","sizes":"200px","preload":false,"className":"otter block h-full w-full object-contain size-full"}]}]}],["$","div",null,{"className":"flex flex-col items-center gap-4 text-center md:items-start md:text-left","children":[["$","h2",null,{"className":"font-autour text-[30px]/[42px] text-brown md:text-[32px]/[44.8px] lg:text-[42px]/[58.8px]","children":"A small part of your story."}],["$","p",null,{"className":"font-autour text-[20px]/[26px] text-cocoa lg:text-[25px]/[32.5px]","children":"Maybe one day you’ll stop by NOOKAA for a drink."}],[["$","p","You won’t know it then, but it might become your first coffee before work, your favourite stop after college, or the sip you celebrate a small win with.",{"className":"font-chiron text-[16px]/[22.4px] text-brown md:text-[18px]/[25.2px] lg:text-[20px]/[28px]","children":"You won’t know it then, but it might become your first coffee before work, your favourite stop after college, or the sip you celebrate a small win with."}],["$","p","Life isn’t remembered only by its big milestones. It’s remembered by the little moments that made us smile. If NOOKAA becomes a small part of one of those memories, we’ll know we’ve created something beyond a beverage brand.",{"className":"font-chiron text-[16px]/[22.4px] text-brown md:text-[18px]/[25.2px] lg:text-[20px]/[28px]","children":"Life isn’t remembered only by its big milestones. It’s remembered by the little moments that made us smile. If NOOKAA becomes a small part of one of those memories, we’ll know we’ve created something beyond a beverage brand."}],["$","p","We want to belong in your everyday life, and we can’t wait to become a small part of your story.",{"className":"font-chiron text-[16px]/[22.4px] text-brown md:text-[18px]/[25.2px] lg:text-[20px]/[28px]","children":"We want to belong in your everyday life, and we can’t wait to become a small part of your story."}]],["$","div",null,{"className":"pt-2","children":[["$","p",null,{"className":"font-autour text-[20px]/[24px] text-espresso","children":"Sip the Happiness."}],["$","p",null,{"className":"font-chiron text-[14px]/[16.8px] text-brown md:text-[16px]/[19.2px]","children":"With warmth, the founder of NOOKAA"}]]}]]}]]}]}]}]}]
