2f:["$","$Ld",null,{"y":20,"className":"nookaa-faq__list","children":[["$","details","What is Nookaa?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"What is Nookaa?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"Nookaa is a grab-and-go brand serving beverages only, with counter pickup and small, temporary seating for a brief stop."}]}]]}],["$","details","How much do Nookaa beverages cost?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"How much do Nookaa beverages cost?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"Beverages range from ₹71 to ₹199. Prices are in INR and taxes are extra. Add-ons are priced separately; see our full menu for every item and price."}]}]]}],["$","details","What cup sizes do you serve?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"What cup sizes do you serve?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"Our hot beverages are served in 250 ml cups and cold beverages in 475 ml cups."}]}]]}],["$","details","How does Nookaa work?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"How does Nookaa work?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"Nookaa is a grab-and-go beverage brand. Walk up to our counter, choose your beverage, collect it and take it along. No reservation is needed."}]}]]}],["$","details","Do you serve food or snacks?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"Do you serve food or snacks?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"We serve beverages only. Explore coffees, matcha, teas, coolers and more on our menu."}]}]]}],["$","details","Is seating available?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"Is seating available?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"Any seating at Nookaa is small and temporary, for a brief stop. Our outlets are designed for beverage pickup, rather than extended stays, working or studying."}]}]]}],["$","details","Do you offer plant-based milk?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"Do you offer plant-based milk?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"Oat milk and almond milk are available as paid add-ons. See the menu for prices."}]}]]}],["$","details","Can I take my beverage to go?",{"className":"nookaa-faq__item","children":[["$","summary",null,{"children":[["$","span",null,{"children":"Can I take my beverage to go?"}],["$","span",null,{"className":"nookaa-faq__toggle","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"nookaa-faq__answer","children":["$","p",null,{"children":"Yes! That’s what Nookaa is made for. Pick up your beverage at the counter and take it wherever your day goes."}]}]]}],["$","details","What can I find in the Nookaa app?",{"cl