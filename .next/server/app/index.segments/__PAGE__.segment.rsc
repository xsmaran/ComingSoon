3:T7cc,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is Nookaa?","acceptedAnswer":{"@type":"Answer","text":"Nookaa is a grab-and-go brand serving beverages only, with counter pickup and small, temporary seating for a brief stop."}},{"@type":"Question","name":"How much do Nookaa beverages cost?","acceptedAnswer":{"@type":"Answer","text":"Beverages range from ₹71 to ₹199. Prices are in INR and taxes are extra. Add-ons are priced separately; see our full menu for every item and price."}},{"@type":"Question","name":"What cup sizes do you serve?","acceptedAnswer":{"@type":"Answer","text":"Our hot beverages are served in 250 ml cups and cold beverages in 475 ml cups."}},{"@type":"Question","name":"How does Nookaa work?","acceptedAnswer":{"@type":"Answer","text":"Nookaa is a grab-and-go beverage brand. Walk up to our counter, choose your beverage, collect it and take it along. No reservation is needed."}},{"@type":"Question","name":"Do you serve food or snacks?","acceptedAnswer":{"@type":"Answer","text":"We serve beverages only. Explore coffees, matcha, teas, coolers and more on our menu."}},{"@type":"Question","name":"Is seating available?","acceptedAnswer":{"@type":"Answer","text":"Any seating at Nookaa is small and temporary, for a brief stop. Our outlets are designed for beverage pickup, rather than extended stays, working or studying."}},{"@type":"Question","name":"Do you offer plant-based milk?","acceptedAnswer":{"@type":"Answer","text":"Oat milk and almond milk are available as paid add-ons. See the menu for prices."}},{"@type":"Question","name":"Can I take my beverage to go?","acceptedAnswer":{"@type":"Answer","text":"Yes! That’s what Nookaa is made for. Pick up your beverage at the counter and take it wherever your day goes."}},{"@type":"Question","name":"What can I find in the Nookaa app?","acceptedAnswer":{"@type":"Answer","text":"Discover rewards, discounts and beverage subscriptions in the Nookaa app."}}]}4:T