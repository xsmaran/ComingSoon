ired":true}]},{"title":"Financial readiness","fields":[{"name":"budget","label":"Your planned investment budget","type":"radio","required":true,"options":["₹10–20 lakhs","₹20–40 lakhs","₹40–60 lakhs","Above ₹60 lakhs"]},{"name":"model","label":"Open to discussing profit-sharing or lease-based operating models?","type":"radio","required":true,"options":["Yes","No","Tell me more"]}]},{"title":"Personal insight","fields":[{"name":"standout","label":"How would your Nookaa outlet stand out locally?","type":"textarea","required":true},{"name":"community","label":"How would you connect with your community?","type":"textarea","required":true},{"name":"achievement","label":"Something you’ve built or managed that makes you proud","type":"textarea","required":true}]}]}}]]}]
